# ============================================================
# ForgePilot — Example Model & TrueForge Configuration
# ============================================================

# TrueForge Local Server Endpoint (default local port: 8790)
TRUEFORGE_ENDPOINT=http://localhost:8790

# TrueForge Server API Key (optional for local SQLite mode)
TRUEFORGE_API_KEY=

# Preferred Primary Model (configured in TrueForge agent manifest)
# Options: gemini-3-1-flash-lite, gemini-flash-latest, openai/chat-latest
FORGEPILOT_PRIMARY_MODEL=gemini-3-1-flash-lite

# Preferred Fallback Model (used when primary encounters transient errors)
FORGEPILOT_FALLBACK_MODEL=gemini-flash-latest

# Context Retrieval Token Budget (default: 20000 tokens)
FORGEPILOT_TOKEN_BUDGET=20000

# Optional Model Provider API Keys (configured inside TrueForge at http://localhost:8790)
# GEMINI_API_KEY=your_google_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
